import java.util.*;

/**
 * =========================================
 * TOKENIZER TESTS
 * =========================================
 */
final class EventTokenizerTest {

    public static void testValidTokenization() {

        EventTokenizer tokenizer = new EventTokenizer();

        List<String> result =
                tokenizer.tokenize("a=1;b=2;c=3");

        if (result.size() != 3) {
            throw new RuntimeException("testValidTokenization : fail");
        }

        if (!result.get(0).equals("a=1")
                || !result.get(1).equals("b=2")
                || !result.get(2).equals("c=3")) {

            throw new RuntimeException("testValidTokenization : fail");
        }

        System.out.println("testValidTokenization : pass");
    }

    public static void testNullInput() {

        EventTokenizer tokenizer = new EventTokenizer();

        List<String> result =
                tokenizer.tokenize(null);

        if (!result.isEmpty()) {
            throw new RuntimeException("testNullInput : fail");
        }

        System.out.println("testNullInput : pass");
    }

    public static void testEmptyInput() {

        EventTokenizer tokenizer = new EventTokenizer();

        List<String> result =
                tokenizer.tokenize("");

        if (!result.isEmpty()) {
            throw new RuntimeException("testEmptyInput : fail");
        }

        System.out.println("testEmptyInput : pass");
    }
}

/**
 * =========================================
 * PARSER TESTS
 * =========================================
 */
final class EventParserTest {

    public static void testValidParsing() {

        EventParser parser = new EventParser();

        List<String> tokens = List.of(
                "event_id=evt_1",
                "amount=100",
                "currency=USD"
        );

        Optional<Map<String, String>> result =
                parser.parse(tokens);

        if (result.isEmpty()) {
            throw new RuntimeException("testValidParsing : fail");
        }

        Map<String, String> parsedMap = result.get();

        if (!parsedMap.get("event_id").equals("evt_1")
                || !parsedMap.get("amount").equals("100")
                || !parsedMap.get("currency").equals("USD")) {

            throw new RuntimeException("testValidParsing : fail");
        }

        System.out.println("testValidParsing : pass");
    }

    public static void testDuplicateKeysFail() {

        EventParser parser = new EventParser();

        List<String> tokens = List.of(
                "amount=100",
                "amount=200"
        );

        Optional<Map<String, String>> result =
                parser.parse(tokens);

        if (result.isPresent()) {
            throw new RuntimeException("testDuplicateKeysFail : fail");
        }

        System.out.println("testDuplicateKeysFail : pass");
    }

    public static void testMalformedKeyValueFail() {

        EventParser parser = new EventParser();

        List<String> tokens = List.of(
                "event_id=evt_1",
                "amount100"
        );

        Optional<Map<String, String>> result =
                parser.parse(tokens);

        if (result.isPresent()) {
            throw new RuntimeException("testMalformedKeyValueFail : fail");
        }

        System.out.println("testMalformedKeyValueFail : pass");
    }

    public static void testMultipleEqualsAllowed() {

        EventParser parser = new EventParser();

        List<String> tokens = List.of(
                "currency=USD===",
                "event_id=evt_1"
        );

        Optional<Map<String, String>> result =
                parser.parse(tokens);

        if (result.isEmpty()) {
            throw new RuntimeException("testMultipleEqualsAllowed : fail");
        }

        if (!result.get().get("currency").equals("USD===")) {
            throw new RuntimeException("testMultipleEqualsAllowed : fail");
        }

        System.out.println("testMultipleEqualsAllowed : pass");
    }
}

