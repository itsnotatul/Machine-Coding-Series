/**
 * =========================================
 * PROCESSOR INTEGRATION TESTS
 * =========================================
 */
final class PaymentEventProcessorTest {

    public static void testProcessorEndToEnd() {

        Set<String> validIds = Set.of("evt_1");

        PaymentEventProcessor processor =
                new PaymentEventProcessor(validIds);

        List<String> rawEvents = List.of(
                "event_id=evt_1;amount=100;currency=USD",
                "event_id=evt_2;amount=200;currency=USD",
                "event_id=evt_1;amount=-50;currency=USD"
        );

        List<EventDto> result =
                processor.process(rawEvents);

        if (result.size() != 1) {
            throw new RuntimeException("testProcessorEndToEnd : fail");
        }

        if (!result.get(0).getEventId().equals("evt_1")) {
            throw new RuntimeException("testProcessorEndToEnd : fail");
        }

        System.out.println("testProcessorEndToEnd : pass");
    }
}

